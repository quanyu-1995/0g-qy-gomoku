{
  "name": "0g-qy-gomoku-service",
  "version": "1.0.0",
  "private": false,
  "description": "Backend service for 0g-qy-gomoku (Express + TypeScript)",
  "main": "dist/index.js",
  "keywords": [
    "chatgpt-web",
    "0G Compute SDK",
    "express"
  ],
  "engines": {
    "node": "^16 || ^18 || ^20"
  },
  "scripts": {
    "start": "esno ./src/index.ts",
    "dev": "esno watch ./src/index.ts",
    "prod": "node ./build/index.mjs",
    "build": "pnpm clean && tsup",
    "clean": "rimraf build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "common:cleanup": "rimraf node_modules && rimraf pnpm-lock.yaml"
  },
  "dependencies": {
    "@0glabs/0g-serving-broker": "^0.6.1",
    "@0glabs/0g-ts-sdk": "^0.3.3",
    "axios": "^1.3.4",
    "chatgpt": "^5.1.2",
    "dotenv": "^16.0.3",
    "esno": "^4.7.0",
    "ethers": "^6.13.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "fastify": "^5.4.0",
    "https-proxy-agent": "^7.0.6",
    "isomorphic-fetch": "^3.0.0",
    "node-fetch": "^3.3.0",
    "openai": "^5.10.1",
    "socks-proxy-agent": "^7.0.0",
    "zod": "^4.0.10"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^0.35.3",
    "@types/express": "^4.17.17",
    "@types/node": "^18.14.6",
    "eslint": "^8.35.0",
    "rimraf": "^4.3.0",
    "tsup": "^6.6.3",
    "typescript": "^4.9.5"
  }
}
